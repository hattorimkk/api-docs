                "image_ids": [
                    "{{image_id}}",
                    "{{image_id}}"
                ]
            }
        ]
    }
}
```

### Các bước tạo quảng cáo thẻ xoay vòng Video Shopping Ads (VSA)
1. Tạo chiến dịch bằng cách gọi endpoint [/campaign/create/](../12-api-reference/24-campaign.md#doc-1739318962329602). Note that in addition to the parameter requirements listed in the section [Create Video Shopping Ads with products from catalogs-1. Create a campaign](use-case-tao-chien-dich-p1.md#doc-1750361698613249), the following requirements must be met at the same time.

| Thiết lập (Setting) | Yêu cầu (Requirement) | Tham số (Parameter) | Hướng dẫn cấu hình tham số |
|---|---|---|---|
| Campaign Budget Optimization (CBO) | Supported with allowlist | `budget_optimize_on` | `false` or `true` ⏎ **Note**: Campaign Budget Optimization for Video Shopping Ads with product source as catalog is currently an allowlist-only feature. If you would like to access it, please contact your TikTok representative. |
| Campaign product source | Catalog | `campaign_product_source` | `CATALOG` |

> [!NOTE] 
> The Smart+ Campaign setting should be disabled for the Carousel campaign. If you are not sure about Liệu campaign is Smart+ Campaign, you can use the `is_smart_performance_campaign` field returned from [/campaign/get/](../12-api-reference/24-campaign.md#doc-1739315828649986) to check.

**Ví dụ mẫu (Example)**

Yêu cầu (Request)
```http
// curl
curl --location --request POST 'https://business-api.tiktok.com/open_api/v1.3/campaign/create/' \
--header 'Access-Token: {{Access-Token}}' \
--header 'Content-Type: application/json' \
--data '{
    "advertiser_id": "{{advertiser_id}}",
    "objective_type": "PRODUCT_SALES",
    "budget_mode": "BUDGET_MODE_TOTAL",
    "budget": 5000,
    "campaign_name": "{{campaign_name}}",
    "campaign_product_source":"CATALOG"
}'
```

Phản hồi (Response)
```http
// curl
{
    "code": 0,
    "message": "OK",
    "request_id": "{{request_id}}",
    "data": {
        "campaign_type": "REGULAR_CAMPAIGN",
        "campaign_product_source": "CATALOG",
        "advertiser_id": "{{advertiser_id}}",
        "campaign_id": "{{campaign_id}}",
        "is_new_structure": true,
        "secondary_status": "CAMPAIGN_STATUS_ENABLE",
        "campaign_app_profile_page_state": "UNSET",
        "roas_bid": 0,
        "modify_time": "2023-06-07 10:55:33",
        "deep_bid_type": null,
        "is_smart_performance_campaign": false,
        "budget": 5000,
        "campaign_name": "{{campaign_name}}",
        "budget_mode": "BUDGET_MODE_TOTAL",
        "objective_type": "PRODUCT_SALES",
        "operation_status": "ENABLE",
        "create_time": "2023-06-07 10:55:33",
        "objective": "LANDING_PAGE"
    }
}
```

2. Create and manage catalogs. Follow the steps outlined in the section [Create Video Shopping Ads with products from catalogs-2. Create and manage catalogs](use-case-tao-chien-dich-p1.md#doc-1750361698613249).

3. Tạo nhóm quảng cáo bằng cách gọi endpoint [/adgroup/create/](../12-api-reference/07-ad-groups-p2.md#doc-1739499616346114). Note that in addition to the requirements listed in the section [Create Video Shopping Ads with products from catalogs-3. Create an ad group](use-case-tao-chien-dich-p1.md#doc-1750361698613249), the following requirements must be met at the same time.

| Thiết lập (Setting) | Yêu cầu (Requirement) | Tham số (Parameter) | Hướng dẫn cấu hình tham số |
|---|---|---|---|
| Placement | •  **Automatic Placement** or  •  **Select Placement** with TikTok placement included | `placement_type` & `placements` | •  Set `placement_type` to `PLACEMENT_TYPE_AUTOMATIC`, or  •  Set `placement_type` to `PLACEMENT_TYPE_NORMAL`, and include `PLACEMENT_TIKTOK` in the value of `placements` |

> [!NOTE] 
> Carousel ad groups can be used in [/split_test/create/](../12-api-reference/65-super-split-test.md#doc-1742666471475201) to create split test groups.

**Ví dụ mẫu (Example)**

Yêu cầu (Request)
```http
// curl
curl --location --request POST 'https://business-api.tiktok.com/open_api/v1.3/adgroup/create/' \
--header 'Access-Token: {{Access-Token}}' \
--header 'Content-Type: application/json' \
--data '{
    "advertiser_id": "{{advertiser_id}}",
    "adgroup_name": "{{adgroup_name}}",
    "campaign_id": "{{campaign_id}}",
    "promotion_type": "APP_ANDROID", 
    "placement_type": "PLACEMENT_TYPE_NORMAL",
    "placements": [
        "PLACEMENT_TIKTOK"
    ],  
    "product_source": "CATALOG",
    "catalog_id": "{{catalog_id}}",
    "catalog_authorized_bc_id": "{{catalog_authorized_bc_id}}",
    "app_id": "{{app_id}}",
    "shopping_ads_retargeting_type": "OFF",    
    "location_ids": [
        "1861060"
    ], 
    "optimization_goal": "CLICK", 
    "bid_type": "BID_TYPE_NO_BID",
    "billing_event": "CPC",
    "schedule_type": "SCHEDULE_START_END",
    "schedule_start_time": "{{schedule_start_time}}",
    "schedule_end_time": "{{schedule_end_time}}", 
    "video_download_disabled": true, 
    "automated_targeting": "OFF",
    "budget_mode": "BUDGET_MODE_TOTAL",
    "budget": {{budget}},
    "gender": "GENDER_UNLIMITED",
    "operating_systems": [
        "ANDROID"
    ],
    "ios14_quota_type": "UNOCCUPIED",
    "operation_status": "ENABLE",
    "pacing": "PACING_MODE_SMOOTH"
}'
```

