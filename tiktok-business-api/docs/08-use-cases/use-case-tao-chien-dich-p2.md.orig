    ],
    "auto_message_list": [
        {
            "auto_message_id": "{{auto_message_id}}"
        }
    ],
    "ad_text_list": [
        {
            "ad_text": "ad_text"
        },
        {
            "ad_text": "ad_text"
        },
        {
            "ad_text": "ad_text"
        },
        {
            "ad_text": "ad_text"
        },
        {
