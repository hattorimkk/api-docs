    "targeting_optimization_mode": "MANUAL",
    "targeting_spec": {
        "location_ids": [
            "{{location_id}}"
        ],
        "operating_systems": [
            "ANDROID"
        ]
    },
    "placement_type": "PLACEMENT_TYPE_NORMAL",
    "placements": [
        "PLACEMENT_TIKTOK"
    ]
}'
