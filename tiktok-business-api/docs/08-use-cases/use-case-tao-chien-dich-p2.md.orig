                "product_image_list": []
            },
            "product_set_id": "{{product_set_id}}",
            "product_specific_type": "ALL",
            "tracking_info": {
                "app_tracking_info_list": [
                    {
                        "app_id": "{{app_id}}",
                        "app_type": "APP_ANDROID",
                        "click_tracking_url": "{{click_tracking_url}}",
                        "impression_tracking_url": "{{impression_tracking_url}}"
                    },
                    {
                        "app_type": "APP_IOS"
                    }
                ],
                "tracking_pixel_id": "{{tracking_pixel_id}}"
            },
            "utm_params": []
        },
        "ad_name": "{{ad_name}}",
        "ad_text_list": [
            {
                "ad_text": "{{ad_text}}"
            }
        ],
        "adgroup_id": "{{adgroup_id}}",
        "adgroup_name": "{{adgroup_name}}",
        "advertiser_id": "{{advertiser_id}}",
        "auto_message_list": [],
        "call_to_action_list": [],
        "campaign_id": "{{campaign_id}}",
        "campaign_name": "{{campaign_name}}",
        "create_time": "{{create_time}}",
        "creative_list": [
            {
                "ad_material_id": "{{ad_material_id}}",
                "creative_info": {
                    "ad_format": "SINGLE_VIDEO",
                    "identity_authorized_bc_id": "{{identity_authorized_bc_id}}",
                    "identity_id": "{{identity_id}}",
                    "identity_type": "BC_AUTH_TT",
                    "image_info": [
                        {
                            "web_uri": "{{web_uri}}"
                        }
                    ],
                    "material_name": "{{material_name}}",
                    "video_info": {
                        "file_name": "{{file_name}}",
                        "video_id": "{{video_id}}"
                    }
                },
                "material_operation_status": "ENABLE",
                "smart_plus_creative_id": "{{smart_plus_creative_id}}"
            },
            {
                "ad_material_id": "{{ad_material_id}}",
                "creative_info": {
                    "ad_format": "CATALOG_CAROUSEL",
                    "identity_authorized_bc_id": "{{identity_authorized_bc_id}}",
                    "identity_id": "{{identity_id}}",
                    "identity_type": "BC_AUTH_TT",
                    "material_name": "{{material_name}}",
                    "music_info": {
                        "music_id": "{{music_id}}"
                    }
                },
                "material_operation_status": "ENABLE",
                "smart_plus_creative_id": "{{smart_plus_creative_id}}"
            }
        ],
        "custom_product_page_list": [],
